<?xml version="1.0" encoding="UTF-8"?>
<!--
  Manifesto do Tizen Web App (TV). Empacota o app que já existe (index.html)
  para rodar na TV Hyundai/Tizen HYEK40FHD (Full HD 1920x1080).

  ATENÇÃO antes de empacotar no Tizen Studio:
  - Troque o prefixo do "package"/"application id" pelo ID gerado junto com o
    seu CERTIFICADO (o Tizen Studio preenche isso ao criar/associar o perfil).
  - Adicione um ícone em "icon.png" na raiz (recomendado 512x512 px).
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://sysmo.com.br/cronometro"
        version="1.0.0"
        viewmodes="maximized">

  <!-- O id ANTES do ponto (ex.: ABCDEFGHIJ) vem do seu certificado. -->
  <tizen:application id="ABCDEFGHIJ.CronometroLuta"
                     package="ABCDEFGHIJ"
                     required_version="2.4"/>

  <!-- Perfil de TV -->
  <tizen:profile name="tv"/>

  <!-- Ponto de entrada = nosso app atual -->
  <content src="index.html"/>

  <name>Cronometro de Luta</name>
  <icon src="icon.png"/>

  <!-- Full HD, paisagem, sem menu de contexto; recebe o botão Voltar físico -->
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"/>

  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>

  <!-- Teclas do controle remoto (setas/OK já são padrão; isto libera as demais) -->
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <!-- Impedir a TV de dormir/screensaver durante o treino -->
  <tizen:privilege name="http://tizen.org/privilege/power"/>

</widget>
